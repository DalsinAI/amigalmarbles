# LMarbles 1.1.2 for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's SDL 1.2
# (sdl12-compat).
#
#   make -f amiga/Makefile.amigaos dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        NDK=/path/to/OpenNDK/Include_H SDLKIT=/path/to/opengpu-sdk
#
# src/Makefile.am's sources, with amiga/config.h for configure's (no
# gettext) and SRC_DIR the drawer's data/. SDLKIT is the OpenGPU developer
# kit: libSDL.a, sdl12-compat on SDL2.module. It has no SDL_mixer 1.2: the
# Team's amiga/sdl_mixer_lite.c (WAV, from the Hex-a-hop port) stands in.
# SDL_RWFromFile is plain stdio (amiga/amiga_rwops.c, -Wl,--wrap), as in
# the Hex-a-hop and Xye ports: the pictures are loaded with SDL_LoadBMP.

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
SDLKIT  ?= /mnt/amigachrome/team2/deps/opengpu-sdk
CC      = $(STOVE)/bin/m68k-amigaos-gcc
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
PROG    = LMarbles
OUT     = dist/LMarbles

DEFS    = -D__amigaos__ -DNDEBUG -DHAVE_CONFIG_H -DSRC_DIR=\"PROGDIR:data\" \
          -DCONFIGDIR=\".\" -DPRF_DIR=\"PROGDIR:user\" -DLOCALEDIR=\"\"
# (amiga/include: the sources include "../config.h", which is then
# amiga/config.h)
INC     = -Iamiga -Iamiga/include -Iamiga/include/SDL -Isrc -I$(SDLKIT)/include/SDL -I$(SDLKIT)/include
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP -std=gnu99 -w
LDFLAGS = -noixemul $(CPU) -Wl,--wrap=SDL_RWFromFile
LIBS    = -L$(SDLKIT)/lib -lSDL -lpthread -lm

SRC     = src/audio.c src/cfg.c src/dynlist.c src/file.c src/game.c src/levels.c \
          src/main.c src/menu.c src/profile.c src/sdl.c src/tools.c
CSRC    = amiga/stack.c amiga/sdl_mixer_lite.c amiga/amiga_rwops.c
OBJS    = $(SRC:%.c=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(BUILD)/$(PROG): $(OBJS)
	$(CC) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Iamiga/include/SDL -I$(SDLKIT)/include/SDL -I$(NDK) -Wall -c -o $@ $<

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DEFS) $(INC) -c -o $@ $<

# The drawer: the program; data/ with the pictures (gfx), the level sets
# and the sounds; upstream's manual (manual/), ReadMe and the licence. The
# settings and the player profiles are kept in the drawer's user/.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)/data
	cp $(BUILD)/$(PROG) $(OUT)/
	cp -R src/gfx src/levels src/sounds $(OUT)/data/
	cp -R src/manual $(OUT)/manual
	find $(OUT) -name 'Makefile.*' -delete
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING.txt
	cp amiga/icons/LMarbles.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/COPYING.txt.info
	cp amiga/icons/ReadMe.info $(OUT)/manual/manual.html.info
	cp amiga/icons/LMarbles-drawer.info dist/LMarbles.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
